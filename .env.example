# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opspilot

# Used when running the API outside docker compose
DATABASE_URL=postgresql://opspilot:change-me@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379/0
